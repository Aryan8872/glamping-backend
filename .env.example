# Email Configuration
# For Gmail: Use app-specific password (https://myaccount.google.com/apppasswords)
# For other providers: Use your SMTP credentials

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Glamping Reservations

# Alternative SMTP providers:
# SendGrid: smtp.sendgrid.net (port 587)
# Mailgun: smtp.mailgun.org (port 587)
# AWS SES: email-smtp.us-east-1.amazonaws.com (port 587)
