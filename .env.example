# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/glampindb?schema=public"

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key

# Email Configuration
# For Gmail: Use app-specific password (https://myaccount.google.com/apppasswords)
# For other providers: Use your SMTP credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Glamping Reservations

# Storage Configuration
# Options: 'local' (default) or 'supabase'
STORAGE_DRIVER=local

# Supabase Storage Configuration (Required if STORAGE_DRIVER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_BUCKET=uploads
