// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlogStatus {
  PUBLISHED
  DRAFT
  DELETED
}

enum GalleryStatus {
  PUBLISHED
  DRAFT
  DELETED
}

enum BookingStatus {
  BOOKED
  CANCELED
}

enum UserType {
  ADMIN
  USER
  CAMPHOST
  SUPERADMIN
}

enum UserStatus {
  DISABLED
  ENABLED
}

enum BookingPaymentStatus {
  PENDING
  CLEARED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id             Int            @id @default(autoincrement())
  fullName       String
  phoneNumber    String
  email          String         @unique
  password       String? // Hashed with bcrypt
  userType       UserType       @default(USER)
  userStatus     UserStatus     @default(ENABLED)
  campBookings   CampBookings[]
  profilePicture String?
  campSite       CampSite[]

  // Auth Relations
  sessions      Session[]
  refreshTokens RefreshToken[]

  // Email Verification
  emailVerifiedAt   DateTime?
  verificationToken String?

  // Host Features
  isFeatured        Boolean @default(false)
  hostTagline       String? // e.g. "Managing 3 campsites"
  yearsOfExperience Int? // e.g. 5
}

model Session {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique // Hashed
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model Blog {
  id              Int        @id @default(autoincrement())
  title           String
  excerpt         String
  content         String
  author          String
  slug            String     @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime   @default(now())
  status          BlogStatus @default(DRAFT)
  metaTitle       String
  metaDescription String
  metaKeywords    String
  indexable       Boolean    @default(true)
  coverImage      String
  tags            String[]
  views           Int        @default(0)
}

model CampSite {
  id                 Int                 @id @default(autoincrement())
  name               String
  description        String
  slug               String              @unique
  images             String[]
  pricePerNight      Decimal             @db.Decimal(10, 2)
  campSiteFacilities CampSiteFacility[]
  campHost           User?               @relation(fields: [hostId], references: [id])
  bookings           CampBookings[]
  hostId             Int?
  location           String?
  latitude           Float?
  longitude          Float?
  adventures         CampSiteAdventure[]
  discounts          Discount[]

  // New Relations
  destinationId Int?
  destination   Destination?         @relation(fields: [destinationId], references: [id])
  experiences   CampSiteExperience[]

  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  isAvailable   Boolean                 @default(true)
  maxAdult      Int                     @default(0)
  maxChildren   Int                     @default(0)
  maxPets       Int                     @default(0)
  search_vector Unsupported("tsvector") @default(dbgenerated())
  isFeatured    Boolean                 @default(false)
}

model Facility {
  id        Int      @id @default(autoincrement())
  name      String
  icon      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campSites CampSiteFacility[]
}

// join table between camp and facility 
model CampSiteFacility {
  id Int @id @default(autoincrement())

  campId     Int
  facilityId Int

  campSite CampSite @relation(fields: [campId], references: [id])
  facility Facility @relation(fields: [facilityId], references: [id])
}

model CampBookings {
  id                   Int                  @id @default(autoincrement())
  userId               Int?
  userInfo             User?                @relation(fields: [userId], references: [id])
  checkInDate          DateTime
  adults               Int                  @default(1)
  children             Int                  @default(0)
  pets                 Int                  @default(0)
  guestUserFullName    String?
  guestUserEmail       String?
  guestUserPhoneNumber String?
  checkOutDate         DateTime
  totalPrice           Decimal              @db.Decimal(10, 2)
  paymentStatus        BookingPaymentStatus @default(PENDING)
  campSiteId           Int
  bookingStatus        BookingStatus        @default(BOOKED)
  campSite             CampSite             @relation(fields: [campSiteId], references: [id])
}

model Adventure {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  slug            String   @unique
  description     String
  coverImage      String
  bannerImage     String
  title           String
  pageDescription String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campSites CampSiteAdventure[]
  discounts Discount[]
}

model Discount {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  type        DiscountType
  amount      Float
  active      Boolean      @default(true)
  isFeatured  Boolean      @default(false)

  campId      Int?
  adventureId Int?

  camp      CampSite?  @relation(fields: [campId], references: [id])
  adventure Adventure? @relation(fields: [adventureId], references: [id])

  startsAt DateTime
  endsAt   DateTime?
}

model CampSiteAdventure {
  id          Int @id @default(autoincrement())
  campId      Int
  adventureId Int

  campSite  CampSite  @relation(fields: [campId], references: [id], onDelete: Cascade)
  adventure Adventure @relation(fields: [adventureId], references: [id], onDelete: Cascade)

  @@unique([campId, adventureId])
}

model Gallery {
  id              Int           @id @default(autoincrement())
  title           String
  description     String
  excerpt         String
  images          String[]
  coverImage      String
  slug            String        @unique
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  galleryStatus   GalleryStatus @default(DRAFT)
  imageAlt        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())
}

model AboutUs {
  id         Int         @id @default(1)
  aboutUs    String
  textbox_1  String
  textbox_2  String
  mission    String
  vision     String
  coreValues CoreValue[]
  stats      Stat[]
  updatedAt  DateTime    @updatedAt
}

model Stat {
  id      Int    @id @default(autoincrement())
  value   String
  icon    String
  heading String

  aboutUsId Int
  aboutUs   AboutUs @relation(fields: [aboutUsId], references: [id])
}

model CoreValue {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  icon        String

  aboutUsId Int
  aboutUs   AboutUs @relation(fields: [aboutUsId], references: [id])
}

model Contact {
  id          Int    @id @default(1)
  email       String
  phoneNumber String
  address     String
}

// New Models

model Destination {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  description String?
  imageUrl    String?
  isFeatured  Boolean @default(false) // For "Top Destinations"
  isActive    Boolean @default(true)

  campSites CampSite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id          Int     @id @default(autoincrement())
  title       String  @unique
  slug        String  @unique
  imageUrl    String?
  description String?
  isActive    Boolean @default(true)

  campSites CampSiteExperience[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CampSiteExperience {
  id           Int @id @default(autoincrement())
  campId       Int
  experienceId Int

  campSite   CampSite   @relation(fields: [campId], references: [id], onDelete: Cascade)
  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([campId, experienceId])
}
